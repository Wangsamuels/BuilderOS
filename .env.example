# ---- core ----
NODE_ENV=development
NETWORK=testnet
PORT=4000
DATABASE_URL=postgres://builderos:builderos@localhost:5432/builderos
SESSION_SECRET=change-me-to-32+-random-bytes
AUTH_RECIPIENT=builderos
LOG_LEVEL=info

# ---- Vercel <-> Heroku wiring ----
# Exact origin(s) of the web app, comma-separated (no trailing slash)
WEB_ORIGIN=http://localhost:3000
# Optional: allow Vercel preview deployments
# WEB_ORIGIN_PATTERN=^https://builderos-[a-z0-9-]+-yourteam\.vercel\.app$
# Only when app.<domain> and api.<domain> share a parent domain:
# COOKIE_DOMAIN=.builderos.dev

# ---- NEAR ----
# NEAR_RPC_URL=https://rpc.testnet.fastnear.com
FACTORY_CONTRACT=builderos.testnet
REGISTRY_CONTRACT=registry.builderos.testnet
# INDEXER_START_BLOCK=
WORKER_ACCOUNT_ID=
WORKER_PRIVATE_KEY=
VERIFIER_ACCOUNT_ID=
VERIFIER_PRIVATE_KEY=
AGENT_KEYSTORE_PATH=./keystore/agents.json
AGENT_KEYSTORE_PASSPHRASE=
# AGENT_KEYSTORE_JSON=   (Heroku: paste the encrypted keystore file contents)

# ---- inference / chains ----
NEAR_AI_API_KEY=
# BASE_RPC_URL=https://sepolia.base.org
# TEMPO_RPC_URL=
TEMPO_ENABLED=false

# ---- local seller mesh (offline demo) ----
USE_SELLER_MESH=true
SELLER_MESH_URL=http://localhost:4100
BRIDGE_MOCK_URL=http://localhost:4100/bridge
ONECLICK_BASE_URL=http://localhost:4100/oneclick

# ---- notifications ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEAR_EMAIL_URL=http://localhost:4100/email/send
NEAR_EMAIL_PAYMENT_KEY=dev
# STABLE_EMAIL_URL=

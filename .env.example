# ---- core ----
NODE_ENV=development
NETWORK=testnet
PORT=4000
DATABASE_URL=postgres://builderos:builderos@localhost:5432/builderos
SESSION_SECRET=change-me-to-32+-random-bytes
AUTH_RECIPIENT=builderos
LOG_LEVEL=info

# ---- Vercel <-> Heroku wiring ----
# Exact origin(s) of the web app, comma-separated (no trailing slash)
WEB_ORIGIN=http://localhost:3000
# Optional: allow Vercel preview deployments
# WEB_ORIGIN_PATTERN=^https://builderos-[a-z0-9-]+-yourteam\.vercel\.app$
# Only when app.<domain> and api.<domain> share a parent domain:
# COOKIE_DOMAIN=.builderos.dev

# ---- NEAR ----
# NEAR_RPC_URL=https://rpc.testnet.fastnear.com
FACTORY_CONTRACT=builderos-wang.testnet
REGISTRY_CONTRACT=registry.builderos-wang.testnet
# INDEXER_START_BLOCK=   # set after factory deploy (explorer block height)
WORKER_ACCOUNT_ID=worker.builderos-wang.testnet
WORKER_PRIVATE_KEY=
VERIFIER_ACCOUNT_ID=verifier.builderos-wang.testnet
VERIFIER_PRIVATE_KEY=
AGENT_KEYSTORE_PATH=./keystore/agents.json
# Encrypts agent request-only keys (not human Privy wallets). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AGENT_KEYSTORE_PASSPHRASE=
# AGENT_KEYSTORE_JSON=   (Heroku: paste the encrypted keystore file contents)

# ---- inference / chains ----
# Models: Near AI via x402 on Base USDC (primary). API key is optional fallback only.
NEAR_AI_X402_BASE_URL=https://x402.pingpay.io
# NEAR_AI_API_KEY=
# NEAR_AI_API_KEY_FALLBACK=false
# BASE_RPC_URL=https://sepolia.base.org
# Tempo/MPP for services that cannot take x402 (models stay on Base USDC x402)
# TEMPO_RPC_URL=https://rpc.tempo.xyz
TEMPO_ENABLED=false
# TEMPO_USDC=0x20C000000000000000000000b9537d11c60E8b50
# Live Relay (Base USDC → Tempo USDC.e). Omit RELAY_BASE_URL to use BRIDGE_MOCK when USE_SELLER_MESH.
# RELAY_BASE_URL=https://api.relay.link
# RELAY_API_KEY=

# ---- local seller mesh (offline demo) ----
USE_SELLER_MESH=true
SELLER_MESH_URL=http://localhost:4100
BRIDGE_MOCK_URL=http://localhost:4100/bridge
ONECLICK_BASE_URL=http://localhost:4100/oneclick

# ---- notifications ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEAR_EMAIL_URL=http://localhost:4100/email/send
NEAR_EMAIL_PAYMENT_KEY=dev
# STABLE_EMAIL_URL=
